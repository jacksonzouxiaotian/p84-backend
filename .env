# =======================
# Flask Application Config
# =======================

# The entry point for Flask to locate the application instance
FLASK_APP=autoapp.py

# Flask environment: "development", "testing", or "production"
FLASK_ENV=development

# Enables live reloading and better debugging in development
FLASK_DEBUG=1

# Secret key for session management, CSRF protection, and security tokens
SECRET_KEY=e02cf64f2025e9fc92573e458fa3f3e4ed1037f34e928b63c1c26534c62e6bd9

# =======================
# Database Config (PostgreSQL)
# =======================

# PostgreSQL database username
POSTGRES_USER=postgres

# PostgreSQL database password
POSTGRES_PASSWORD=9900H16ABread

# PostgreSQL database name
POSTGRES_DB=mydb

# Full database connection string used by SQLAlchemy
DATABASE_URL=postgresql://postgres:9900H16ABread@db:5432/mydb

# =======================
# Logging / Gunicorn
# =======================

# Number of worker processes for handling requests (Gunicorn)
GUNICORN_WORKERS=4

# Logging verbosity level: debug, info, warning, error
LOG_LEVEL=info

# Application port inside the container
PORT=5000

# Browser caching for static files (in seconds); 0 disables caching
SEND_FILE_MAX_AGE_DEFAULT=0

# =======================
# Email Server Config
# =======================

# SMTP server address for sending emails
MAIL_SERVER=smtp.qq.com

# Port for SMTP server (587 for TLS)
MAIL_PORT=587

# Sender email address
MAIL_USERNAME=2431384821@qq.com

# SMTP authorization code or password
MAIL_PASSWORD=thqtshtxehtleadg

# Enable Transport Layer Security (TLS) for secure email transmission
MAIL_USE_TLS=True

# =======================
# JWT (JSON Web Token) Config
# =======================

# Secret key for signing JWT tokens
JWT_SECRET_KEY=xF2k5Pgz3mViL5--bYwL8RYVaYcX13xSwJtDJI_uF7A

# =======================
# AWS S3 Storage Config
# =======================

# AWS access key ID for S3 operations
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS secret access key for S3 operations
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Name of the S3 bucket used for storing uploaded files
AWS_S3_BUCKET_NAME=9900-files

# AWS region where the S3 bucket is hosted
AWS_S3_REGION=ap-southeast-2

# =======================
# Google API Config
# =======================

# API key for accessing Google services
GOOGLE_API_KEY=AIzaSyDOos5Hi67ytRjfSKUyEEGKZgJsSB7Zt0c

# =======================
# Testing Database Config
# =======================

# In-memory SQLite database URL for running unit tests
TEST_DATABASE_URL=sqlite:///:memory:
